# =============================================================================
# Root .gitignore — Property Management System
# Synced from backend/.gitignore + frontend/.gitignore + root specifics
# =============================================================================

# ── Environment ────────────────────────────────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ── Python cached artifacts ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Node.js / Frontend ─────────────────────────────────────────────────────
node_modules/
dist/
*.local

# ── Virtual environment ────────────────────────────────────────────────────
.venv/
venv/
env/

# ── IDE and editor files ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.orig

# ── Testing artifacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.coverage
coverage/
test-reports/
.coverage-report/
.playwright_cache/
.playwright-mcp/
playwright-report/
e2e-results/

# ── Type checking ──────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.stubs/

# ── Alembic / migration artifacts ─────────────────────────────────────────
alembic/versions/*.pyc

# ── Docker / container artifacts ───────────────────────────────────────────
.docker/
postgres-data/
redis-data/
minio-data/

# ── Bundle analysis ────────────────────────────────────────────────────────
stats.html

# ── Build output ───────────────────────────────────────────────────────────
*.egg-info/

# ── OS files ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ── Debug logs ─────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── MSW (Mock Service Worker) ──────────────────────────────────────────────
public/mockServiceWorker.js

# ── Caddy ──────────────────────────────────────────────────────────────────
caddy/

# ── Local agents/skills ────────────────────────────────────────────────────
.agents/