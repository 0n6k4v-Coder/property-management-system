# backend/.env.example
# Copy เป็น .env แล้วแก้ไขค่าก่อนเริ่มพัฒนา

# =============================================================================
# Application Settings
# =============================================================================
DEBUG=true
APP_DOMAIN=http://localhost:8000
BACKEND_PORT=8000

# =============================================================================
# Security — Generate new values for each environment!
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=Oo6iLbIrYiF3BzKPedmjd0R6_dvrtgpksv8ViB5Zim8
ID_CARD_ENCRYPTION_KEY=lGeEf6hglbaNm9YuUclBovPEQH31xhXZgIreMd7Tu5A=

# =============================================================================
# Password Hashing (Argon2id — OWASP 2026 recommendations, RFC 9106)
# =============================================================================
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1

# =============================================================================
# Database — PostgreSQL 18.4
# =============================================================================
DB_USER=user
DB_PASSWORD=pass
DB_NAME=pms_test
DB_HOST_PORT=5432
# Asyncpg pool tuning (SDD §4.3.2)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# =============================================================================
# Redis — Cache & Celery Broker
# =============================================================================
REDIS_HOST_PORT=6379

# =============================================================================
# MinIO — File Storage
# =============================================================================
MINIO_ROOT_USER=minio_7b255e23
MINIO_ROOT_PASSWORD=pr64JFuZnV6oEFYSCtBAK5uWig
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# =============================================================================
# Build & Test
# =============================================================================
# Override Docker build target: development | testing | production
BUILD_TARGET=development