# =============================================================================
# backend/.env.production.example — Sprint 8 Production Environment Template
# Property Management System Backend
#
# Copy to .env and fill in all required values before starting production stack.
#   cp .env.production.example .env && $EDITOR .env
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Property Management System
APP_VERSION=1.0.0
DEBUG=false
APP_DOMAIN=https://pms.yourdomain.com
CORS_ORIGINS=https://pms.yourdomain.com,https://admin.yourdomain.com

# ── Security (REQUIRED — generate strong keys) ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SECRET_KEY must be >= 32 characters
SECRET_KEY=change-this-to-a-random-64-char-string

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ID_CARD_ENCRYPTION_KEY=change-this-to-a-44-char-valid-fernet-key=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:***@db:5432/pms_prod
DB_USER=user
DB_PASSWORD=change-this-db-password
DB_NAME=pms_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_PRE_PING=true

# PostgreSQL tuning
DB_POSTGRES_MAX_CONNECTIONS=200
DB_SHARED_BUFFERS=512MB
DB_EFFECTIVE_CACHE_SIZE=2GB
DB_WORK_MEM=8MB

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:***@redis:6379/0
REDIS_PASSWORD=change-this-redis-password
REDIS_MAX_MEMORY=512mb

# ── MinIO (Object Storage) ──────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-secret
MINIO_BACKUP_BUCKET=pms-backups

# ── Backup ──────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30