{
  "name": "property-management-system-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "reactDoctor": {
    "rules": {
      "deslop/unused-export": "off",
      "deslop/unused-file": "off"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse": "lhci autorun",
    "bundle:analyze": "npm run build && open stats.html",
    "bundle:size": "vite build && ls -lh dist/assets/*.js | awk '{print $5, $9}'",
    "react-doctor": "npx react-doctor@latest --threshold 90 --format table"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.100.0",
    "idb": "^8.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.76.1",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-doctor": "^0.2.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.0",
    "msw": "^2.14.0",
    "postcss": "^8.5.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.0",
    "terser": "^5.39.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
