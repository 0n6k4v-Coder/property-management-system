# Frontend Environment Variables
# Copy this file to .env and fill in values, then restart the dev server.

# API Base URL for the backend (FastAPI)
# Default: http://localhost:8000
# In production, set to the deployed API URL, e.g. https://api.yourdomain.com
VITE_API_URL=http://localhost:8000

# Environment label (used for conditional logging/features)
# Values: development | staging | production
NODE_ENV=development
